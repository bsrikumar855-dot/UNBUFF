# Build-time settings for the UNBLUFF frontend. A TEMPLATE: replace every <...>. None of these is a secret (they are
# baked into the public JavaScript), but they must be the PRODUCTION values, not the test project's.
# Use:  cp production.env.example .env.production   (git-ignored)  then  npm run build
VITE_API_URL=https://<api-host>
# Firebase console > Project settings > Your apps > Web app (the production project)
VITE_FIREBASE_API_KEY=<web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<production-firebase-project-id>
VITE_FIREBASE_APP_ID=<web-app-id>
# Address shown on the Privacy and Terms pages for data requests (required before a public launch).
VITE_CONTACT_EMAIL=privacy@<your-domain>
# Optional, for App Check (reCAPTCHA v3 site key); see docs/production-settings.md.
# VITE_FIREBASE_APPCHECK_SITE_KEY=<site-key>
