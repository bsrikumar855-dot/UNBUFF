VITE_API_URL=http://localhost:8090

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These identify the project; they are not secrets. Leave blank to run without sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development only: Firebase Auth emulator (npx firebase-tools emulators:start --only auth)
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Production: the Render backend, e.g. https://unbluff-api.onrender.com
