{
  "name": "unbluff-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prestart": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "bash scripts/smoke.sh",
    "career:smoke": "tsx scripts/career_smoke.ts",
    "grade-check": "tsx scripts/grade_check.ts",
    "demo-report": "tsx scripts/build_demo_report.ts",
    "test:emulator": "npx --yes firebase-tools@15.34.0 emulators:exec --only auth,firestore --project demo-unbluff \"vitest run -c vitest.emulator.config.ts\"",
    "dsa:import": "tsx scripts/dsa_import.ts",
    "dsa:validate": "tsx scripts/dsa_validate.ts",
    "code:import-suite": "tsx scripts/code_import_suite.ts",
    "practice:build": "tsx scripts/build_practice_pack.ts",
    "smoke:judge0": "tsx scripts/judge0_smoke.ts",
    "indexes:check": "tsx scripts/firestore_index_check.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google/genai": "^2.31.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "typescript": "~5.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
