# Production settings for the UNBLUFF backend (Render). A TEMPLATE: every <...> is a placeholder you replace.
# Do NOT put real secrets in this file or commit a filled copy. Keep your filled copy outside the repo and check it with:
#   cd backend && npm run preflight -- /path/to/your/production.env
# On Render, enter these in the dashboard (Environment). render.yaml already sets the non-secret ones.
# Full explanation of each line: docs/production-settings.md

NODE_ENV=production
LLM_MODE=live
STORE=firestore
TRUST_PROXY=1
LOG_LEVEL=info

# ---- Required values from your accounts ----
FIREBASE_PROJECT_ID=<production-firebase-project-id>
# SECRET. The whole service-account JSON on ONE line (Firebase console > Project settings > Service accounts > Generate new private key).
FIREBASE_SERVICE_ACCOUNT_JSON=<paste-json-on-one-line>
# The exact deployed frontend origin: scheme + host, no path, no trailing slash. Several: comma-separated.
CORS_ORIGIN=https://<your-frontend-domain>
# SECRET. Google AI Studio key.
GEMINI_API_KEY=<new-gemini-api-key>

# ---- Model (cheap and fast primary, stronger fallback for overload) ----
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
MENTOR_TEMPERATURE=0.7

# ---- Cost and abuse controls (tune after the first week) ----
LLM_DAILY_BUDGET=150
MAX_SESSIONS_PER_STUDENT=50
REQUIRE_EMAIL_VERIFICATION=true
SESSION_RETENTION_DAYS=365
# off -> monitor -> enforce, once the frontend is built with the App Check site key.
APP_CHECK=off

# ---- Code execution: off until a verified Judge0 server exists ----
EXECUTION_PROVIDER=none
LATEX_COMPILER=none
# When Judge0 is ready:  EXECUTION_PROVIDER=judge0  JUDGE0_URL=https://<judge0-host>  JUDGE0_AUTH_TOKEN=<secret>
# then run `npm run smoke:judge0`, and only if it passes set EXECUTION_PROVIDER_VERIFIED=true

# ---- Optional features ----
LEETCODE_PUBLIC_LOOKUP=false
# GitHub insights are on only if ALL of these are set:
# GITHUB_CLIENT_ID=<oauth-client-id>
# GITHUB_CLIENT_SECRET=<SECRET new client secret>
# GITHUB_REDIRECT_URI=https://<api-host>/api/github/oauth/callback
# GITHUB_FRONTEND_URL=https://<your-frontend-domain>
# GITHUB_TOKEN_ENCRYPTION_KEY=<SECRET: output of  openssl rand -base64 32>
