# live | mock
#   live = the real Gemini model through this server (needs GEMINI_API_KEY and GEMINI_MODEL below). Use this for real use.
#   mock = a canned stand-in that needs no key. For automated tests and offline UI work only: the app labels it "Mock mode".
#   NODE_ENV=production refuses mock unless ALLOW_MOCK_LLM=true is also set.
LLM_MODE=mock
GEMINI_API_KEY=
# Required when LLM_MODE=live, e.g. gemini-3.6-flash
GEMINI_MODEL=
# Optional: model used for the one retry after a 429/5xx, e.g. gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
# Thinking level for grading/extraction: MINIMAL | LOW | MEDIUM | HIGH
GRADE_THINKING=LOW
# Set to true if your key is a Vertex AI (express mode) key
GOOGLE_GENAI_USE_VERTEXAI=false
PORT=8080
# Comma-separated allowed origins. If unset outside production, defaults to http://localhost:5173,http://127.0.0.1:5173.
# REQUIRED when NODE_ENV=production and "*" is rejected there. Bare origins only (no path or trailing slash).
CORS_ORIGIN=http://localhost:5173
# Reverse-proxy hops in front of the app (Cloud Run / Render = 1). 0 disables.
TRUST_PROXY=1
# memory | firestore. Production requires firestore (see docs/phase-2-auth-storage.md).
STORE=memory
# Production only, to knowingly accept losing every session on restart:
# ALLOW_EPHEMERAL_STORE=true
# Firebase project whose ID tokens are accepted. Required in production. Locally defaults to
# demo-unbluff, which works with the Firebase Auth emulator (FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099).
FIREBASE_PROJECT_ID=
# Firestore credentials on hosts without a cloud identity (e.g. Render): the service-account JSON, as a secret.
# Never commit it. Not needed on Cloud Run (the service identity is used).
FIREBASE_SERVICE_ACCOUNT_JSON=
LOG_LEVEL=info
# Approved DSA catalogue JSON (produced by `npm run dsa:import`). Unset: the labelled dev fixture locally,
# an empty catalogue in production. See docs/phase-3-dsa-arena.md.
DSA_CATALOGUE_PATH=

# ---- Code execution (Phase 4). See docs/phase-4-code-workspace.md ----
# none (default): Run/Submit report "unavailable". judge0: use the Judge0 service at JUDGE0_URL.
EXECUTION_PROVIDER=none
# Base URL of YOUR Judge0 deployment (https in production; http only for localhost in development). No path/query/credentials.
JUDGE0_URL=
# Secret. Server-side only. Judge0 default header is X-Auth-Token; change JUDGE0_AUTH_HEADER if your admin renamed it.
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token
CODE_CPU_TIME_SECONDS=2
CODE_MEMORY_MB=128
CODE_JUDGE_DEADLINE_MS=60000
# Server-only hidden test suites (npm run code:import-suite). Unset: dev fixture locally, none in production.
CODE_SUITES_PATH=
# Set to true ONLY after you have confirmed JUDGE0_URL is a real, working Judge0 deployment. Until then judged
# submissions are excluded from DSA analytics (a stand-in or mock service cannot be told apart from a real one).
EXECUTION_PROVIDER_VERIFIED=false
# Defaults when the two paths above are unset: local development uses the labelled demonstration fixtures
# (never counted in analytics); NODE_ENV=production uses the first-party practice pack in data/dsa/practice-pack.json
# and data/code/practice-suites.json. Set DSA_CATALOGUE_PATH and CODE_SUITES_PATH together if you override them.
# Regenerate the pack with `npm run practice:build`; verify the execution service with `npm run smoke:judge0`;
# check Firestore indexes with `npm run indexes:check`.

# AI mentor (uses GEMINI_API_KEY; with no key the mock mentor answers and is labelled as such)
MENTOR_MODEL=
MENTOR_TEMPERATURE=0.7
MENTOR_TIMEOUT_MS=30000
MENTOR_CONVERSATION_RETENTION_DAYS=90
MENTOR_SUMMARY_RETENTION_DAYS=365
MENTOR_LEARNING_RETENTION_DAYS=180

# GitHub contribution insights (optional; set ALL of the first four or none). Read-only, public data only.
# Register an OAuth App at github.com/settings/developers with the callback URL below. Do not request any scope.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must equal the OAuth App's "Authorization callback URL" (https in production)
GITHUB_REDIRECT_URI=http://localhost:8080/api/github/oauth/callback
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store it in a secret manager, never in the database or the repository.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Earlier keys (comma-separated) still accepted for decryption after a rotation
GITHUB_TOKEN_ENCRYPTION_KEY_RETIRED=
# Where the browser returns after GitHub (defaults to the first CORS_ORIGIN)
GITHUB_FRONTEND_URL=
GITHUB_FRESH_MINUTES=360
GITHUB_MIN_SYNC_INTERVAL_MINUTES=5
GITHUB_TIMEOUT_MS=10000

# ---- Local code execution without Judge0 (development only; refused in production) ----
# EXECUTION_PROVIDER=docker runs code in throwaway Docker containers (no network, capped memory/pids).
# Build the image once: docker build -t unbluff-runner:1 backend/scripts/runner
# CODE_WORK_DIR must be a directory the Docker daemon can see (snap Docker cannot see /tmp), e.g. /home/<you>/.cache/unbluff-run
# EXECUTION_PROVIDER=docker
# CODE_WORK_DIR=

# ---- Optional LeetCode lookup by username (OFF by default) ----
# true: a student types their public LeetCode username and UNBLUFF looks up their solved counts from LeetCode's
# unofficial `graphql` endpoint (the one its own website uses). LeetCode's terms forbid automated access like this,
# so turning this on is the operator's own decision and risk. Sends only the username; one lookup per student per 10 minutes.
# LEETCODE_PUBLIC_LOOKUP=false

# ---- Résumé builder: building PDFs from LaTeX (development only; refused in production) ----
# docker: each build runs TeX in a throwaway container (no network, read-only, shell escape off, 25 s limit).
# Build the image once: docker build -t unbluff-latex:1 backend/scripts/latex   (about 1 GB)
# none (default): editing, saving and the ATS score work; only "Build PDF" is unavailable. Uses CODE_WORK_DIR like the code runner.
# LATEX_COMPILER=none
