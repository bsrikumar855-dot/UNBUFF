rules_version = '2';

// The browser never talks to Firestore: the app only uses Firebase Authentication on the client, and every read and
// write goes through the backend with the Admin SDK (which is not subject to these rules). So client access is denied
// for every collection, including the server-only ones (GitHub connections, mentor memory, submissions).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
